      {"kind": "group", "id": "contenido", "label": "Contenido", "icon": "description", "children": [
        {"field": "content", "label": "Contenido (formato libre)"}]}
    ]
  },
  {
    "name": "Reporte ejecutivo",
    "kind": "output",
    "applies_to": "report",
    "description": "Resumen corto para quien no necesita el detalle completo.",
    "body": [
      {"field": "summary", "label": "Resumen"}, {"field": "coverage", "label": "Cobertura"}, {"field": "risks", "label": "Riesgos"}
    ]
  },
  {
    "name": "Especificación detallada",
    "kind": "output",
    "applies_to": "report",
    "description": "Documento completo de nivel profesional: historia, criterios en Gherkin, Definición de Listo/Hecho, contexto de negocio, dependencias, casos de prueba y trazabilidad.",
    "body": [
      {"field": "story", "label": "Historia de usuario"}, {"field": "criteria", "label": "Criterios de aceptación"},
      {"field": "definition_of_ready", "label": "Definición de Listo"}, {"field": "definition_of_done", "label": "Definición de Hecho"},
      {"field": "business_rules", "label": "Reglas de negocio"}, {"field": "assumptions", "label": "Supuestos"},
      {"field": "business_risks", "label": "Riesgos"}, {"field": "out_of_scope", "label": "Fuera de alcance"},
      {"field": "dependencies", "label": "Depende de"}, {"field": "test_cases", "label": "Casos de prueba"},
      {"field": "traceability", "label": "Trazabilidad"}
    ]
  },
  {
    "name": "Matriz de trazabilidad",
    "kind": "output",
    "applies_to": "report",
    "description": "HU → Casos de prueba → estado de ejecución, en una sola tabla.",
    "body": [
      {"field": "matrix", "label": "Matriz HU → Casos de prueba → Estado"}
    ]
  }
]
